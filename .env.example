# ── Synaxis 環境変数サンプル ───────────────────────────────────────────
# 実値は .env.local に置く（.env* は Git 管理外）。
#
# ローカル開発では `npm run db:start`（= supabase start）の出力に
# API URL / publishable(anon) key / secret(service_role) key が表示される。
# それぞれ下記へ転記する。

# クライアント・サーバー双方で使う公開情報（@supabase/ssr が使用）。
# 通常の画面・API 処理はこの publishable キーのみを使い、RLS を必ず通す。
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54521"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase start が出力する anon / publishable key>"

# ── サーバー専用・取り扱い注意 ────────────────────────────────────────
# RLS をバイパスできる秘密鍵。通常の画面・API では絶対に使わない。
# 一度限りのデータ移行スクリプト等、管理用途のみ（scripts/ 配下）で使用する。
# ブラウザバンドルへ含めない。NEXT_PUBLIC_ を絶対に付けない。
SUPABASE_SECRET_KEY="<supabase start が出力する service_role / secret key>"

# アプリの公開 URL（メールのマジックリンク等で使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Google スプレッドシート連携（Phase 3・サーバ専用）─────────────────────
# Google Cloud の OAuth クライアント（ウェブアプリ）。NEXT_PUBLIC を付けない。
# 設定手順は README「Google 連携セットアップ」を参照。未設定でも他機能は動く。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
# refresh_token を暗号化する鍵（DB に保存しない）。`openssl rand -base64 32` 等で生成。
# SUPABASE_SECRET_KEY と同じ「サーバ専用・ブラウザに出さない」区分。
GOOGLE_TOKEN_ENC_KEY=""

# ── データ移行スクリプト専用（scripts/。アプリ実行には不要）──────────────
# migrate-from-excel.ts / migrate-from-prototype.ts の投入先教会 UUID
TARGET_CHURCH_ID=""
# migrate-from-prototype.ts の移行元（旧プロトタイプ）
SOURCE_SUPABASE_URL=""
SOURCE_SUPABASE_KEY=""
# 日付解釈のタイムゾーン（既定 Asia/Tokyo）
CHURCH_TZ="Asia/Tokyo"
